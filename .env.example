DATABASE_URL="postgresql://postgres:postgres@localhost:5432/youtube_highlight?schema=public"
PORT=3001

# FFmpeg binary. On Windows this can be a full path, for example:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Put source video files here using the YouTube external ID as the filename.
# Example: storage/sources/L5yPy0tvG4U.mp4
VIDEO_SOURCE_DIR=./storage/sources

# Rendered MP4/WebM files are written here.
RENDER_OUTPUT_DIR=./storage/renders
